#!/usr/bin/env bash
# The one test that decides whether a local model is usable as an agent.
#
#   toolcall-check                       # the active model
#   toolcall-check gemma4-12b-qat:ctx32k # any Ollama tag
#
# A model that answers with tool_calls populated can drive OpenCode and Pi.
# A model that puts the call in `content` as a string will narrate instead of
# acting — it will tell you it is writing the file, and no file will appear.
# Run this before you trust a new tag, not after an hour of confusion.
#
# This matters most for aggressively quantized models: low-bit quantization
# degrades structured output before it degrades prose, so a model can chat
# perfectly well and still be useless inside an agent loop.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck source=../lib/registry.sh
source "$REPO_ROOT/lib/registry.sh"

if [[ -n "${1:-}" ]]; then
  MODEL="$1"
else
  need_registry
  MODEL="$(runtime_tag "$(active_model)")"
fi

need_jq
require_ollama

echo "Testing tool_calls support for: $MODEL"

REQUEST=$(jq -n --arg model "$MODEL" '{
  model: $model,
  stream: false,
  messages: [
    { role: "user", content: "Write hello.txt containing '\''hi'\''. Use the write_file tool." }
  ],
  tools: [
    {
      type: "function",
      function: {
        name: "write_file",
        description: "Write text content to a file on disk",
        parameters: {
          type: "object",
          properties: {
            path:    { type: "string", description: "File path to write" },
            content: { type: "string", description: "Text to write" }
          },
          required: ["path", "content"]
        }
      }
    }
  ]
}')

RESPONSE=$(printf '%s' "$REQUEST" | curl -sS --max-time 180 http://localhost:11434/api/chat -d @-)

echo "$RESPONSE" | jq '.message | {content, tool_calls}'

if echo "$RESPONSE" | jq -e '.message.tool_calls | length > 0' >/dev/null 2>&1; then
  echo
  echo "PASS — real tool_calls. This model can drive OpenCode and Pi."
else
  echo
  echo "FAIL — no tool_calls. This model will narrate, not act."
  echo "       Try a higher quant, or pick another model."
  exit 1
fi
