#!/usr/bin/env bash
# Launch OpenCode or Pi on the active local model. Nothing here touches the
# network — this exists for when there isn't one.
#
#   agent-run opencode
#   agent-run pi
#   agent-run opencode --model glm47-flash-q2     # override for one run
#
# Called by the tmux bindings in config/tmux/agent.tmux.conf.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck source=../lib/registry.sh
source "$REPO_ROOT/lib/registry.sh"

AGENT="${1:-opencode}"
shift || true

MODEL=""
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model) MODEL="$2"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

need_registry
[[ -n "$MODEL" ]] || MODEL="$(active_model)"
model_exists "$MODEL" || die "unknown model: $MODEL (try: agent-model list)"

require_ollama
TAG="$(runtime_tag "$MODEL")"

if ! ollama list 2>/dev/null | awk '{print $1}' | grep -qx "$TAG"; then
  die "$TAG is not built yet. Run: agent-model pull $MODEL"
fi

echo "→ $AGENT on $TAG (local)" >&2

case "$AGENT" in
  opencode) exec opencode --model "ollama/$TAG" ${ARGS+"${ARGS[@]}"} ;;
  pi)       exec pi --model "$TAG" --api-key ollama ${ARGS+"${ARGS[@]}"} ;;
  *)        die "unknown agent: $AGENT (expected 'opencode' or 'pi')" ;;
esac
