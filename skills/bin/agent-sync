#!/usr/bin/env bash
# Regenerate both agent configs from models/registry.json.
#
# The registry is the single source of truth. opencode.json and pi/models.json
# are build artifacts — edit the registry and re-run this, never the other way
# round, or your next sync silently discards the hand edit.
#
#   agent-sync            # regenerate both configs
#   agent-sync --print    # show what would be written, write nothing

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck source=../lib/registry.sh
source "$REPO_ROOT/lib/registry.sh"

need_registry

PRINT=0
[[ "${1:-}" == "--print" ]] && PRINT=1

ACTIVE="$(active_model)"
model_exists "$ACTIVE" || die "active model '$ACTIVE' is not in the registry"

ACTIVE_TAG="$(runtime_tag "$ACTIVE")"

# Every registered model is offered to both agents, so /model switching works
# in-session without a resync. The active one is only the default.
OPENCODE_JSON="$(jq -n --slurpfile r "$REGISTRY" --arg activeTag "$ACTIVE_TAG" '
  ($r[0]) as $reg |
  {
    "$schema": "https://opencode.ai/config.json",
    model: "ollama/\($activeTag)",
    provider: {
      ollama: {
        npm: "@ai-sdk/openai-compatible",
        name: "Ollama (local)",
        options: { baseURL: "http://localhost:11434/v1" },
        models: (
          $reg.models
          | to_entries
          | map({
              key: "\(.key):ctx\((.value.context // 32768) / 1024 | floor)k",
              value: {
                name: "\(.value.label // .key) — \(((.value.context // 32768) / 1024 | floor))k",
                limit: {
                  context: (.value.context // 32768),
                  output: (.value.maxTokens // 8192)
                }
              }
            })
          | from_entries
        )
      }
    }
  }
')"

PI_JSON="$(jq -n --slurpfile r "$REGISTRY" '
  ($r[0]) as $reg |
  {
    providers: {
      ollama: {
        baseUrl: "http://localhost:11434/v1",
        api: "openai-completions",
        apiKey: "ollama",
        compat: {
          supportsDeveloperRole: false,
          supportsReasoningEffort: false
        },
        models: (
          $reg.models
          | to_entries
          | map({
              id: "\(.key):ctx\((.value.context // 32768) / 1024 | floor)k",
              name: (.value.label // .key),
              reasoning: (.value.reasoning // false),
              input: ["text"],
              contextWindow: (.value.context // 32768),
              maxTokens: (.value.maxTokens // 8192),
              cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }
            })
        )
      }
    }
  }
')"

if [[ $PRINT == 1 ]]; then
  echo "--- config/opencode/opencode.json"
  echo "$OPENCODE_JSON"
  echo "--- config/pi/models.json"
  echo "$PI_JSON"
  exit 0
fi

printf '%s\n' "$OPENCODE_JSON" | write_json "$REPO_ROOT/config/opencode/opencode.json"
printf '%s\n' "$PI_JSON"       | write_json "$REPO_ROOT/config/pi/models.json"

COUNT="$(jq -r '.models | length' "$REGISTRY")"
echo "synced $COUNT model(s); default is $ACTIVE_TAG"
