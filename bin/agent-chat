#!/usr/bin/env bash
# A plain chat REPL against the already-running model.
#
#   agent-chat                      interactive
#   agent-chat "one-off question"   ask once, print, exit
#
# In-chat commands: /reset  /system <text>  /tokens  /exit
#
# WHY THIS EXISTS
#
# mlx_lm.server is an API, not a website. Opening http://127.0.0.1:8080 in a
# browser returns 404 because there is no UI to serve — only /v1/models and
# /v1/chat/completions. That is the correct behaviour, and surprising if you
# expect a ChatGPT-style page.
#
# This talks to the SAME resident model over that API, so it costs no extra
# memory. `mlx_lm.chat` would load a second copy of the weights, which on a
# 16GB machine is how you start swapping.
#
# For actual work — reading and editing files, running commands — use the
# agents instead: agent-run opencode, or prefix + o in tmux.

set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(cd "$(dirname "$SELF")" && pwd)/$LINK" ;;
  esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck source=../lib/registry.sh
source "$REPO_ROOT/lib/registry.sh"

need_registry

if ! server_running; then
  echo "server not up at $(server_url); starting it" >&2
  "$HERE/agent-serve" start
fi

MODEL="$(model_repo "$(active_model)")"
URL="$(server_url)/v1/chat/completions"
MAXTOK="$(jq -er --arg n "$(active_model)" '.models[$n].maxTokens // 2048' "$REGISTRY")"

# stdlib only, and run from a FILE rather than a heredoc: `python - <<EOF`
# would feed the script in on stdin, leaving input() nothing to read, so the
# REPL would exit the instant it started.
exec "$(agent_python)" "$REPO_ROOT/lib/chat.py" "$URL" "$MODEL" "$MAXTOK" ${1+"$1"}
