#!/usr/bin/env bash
# Launch OpenCode or Pi against the local mlx-lm server, starting it if needed.
# Nothing here touches the network — this exists for when there isn't one.
#
#   agent-run opencode
#   agent-run pi
#
# To change model, go through the registry rather than passing a flag here:
#   agent-model use <name> && agent-serve restart
# On 16GB, loading a second model while the first is resident is how you end up
# swapping mid-session.

set -euo pipefail

# Resolve through symlinks: install.sh links bin/* into ~/.local/bin, and the
# scripts must still find lib/ in the real repo. macOS has no portable
# `readlink -f`, so walk the links by hand.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(cd "$(dirname "$SELF")" && pwd)/$LINK" ;;
  esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck source=../lib/registry.sh
source "$REPO_ROOT/lib/registry.sh"

AGENT="${1:-opencode}"
shift || true

need_registry
ACTIVE="$(active_model)"
REPO="$(model_repo "$ACTIVE")"

if ! server_running; then
  echo "server not up; starting it" >&2
  "$HERE/agent-serve" start "$ACTIVE"
elif [[ "$(running_model)" != "$REPO" ]]; then
  echo "server is holding $(running_model) but $ACTIVE is active; restarting" >&2
  "$HERE/agent-serve" restart "$ACTIVE"
fi

echo "→ $AGENT on $REPO (mlx-lm, local)" >&2

case "$AGENT" in
  opencode) exec opencode --model "mlx/$REPO" "$@" ;;
  pi)       exec pi --model "$REPO" --api-key mlx "$@" ;;
  *)        die "unknown agent: $AGENT (expected 'opencode' or 'pi')" ;;
esac
